rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Common functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Portfolio collections - public read access
    match /photography/{photoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /film/{filmId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /webdev/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /nfts/{nftId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /dance/{danceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Category metadata - public read access
    match /{category}/metadata {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inquiries collection - public write (for contact form), admin-only read
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 